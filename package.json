{
  "name": "medguard-backend",
  "version": "0.3.0",
  "private": true,
  "description": "Drishti — Healthcare PHI Risk Intelligence Platform API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run && vitest run --config vitest.demo-reset.config.ts && vitest run --config vitest.meridian-seed.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:demo-reset": "vitest run --config vitest.demo-reset.config.ts",
    "test:meridian-seed": "vitest run --config vitest.meridian-seed.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy",
    "docker:build": "docker build -t drishti-api .",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:bootstrap": "tsx prisma/seed-bootstrap.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "db:demo:reset": "tsx prisma/reset-demo.ts",
    "db:e2e:reset": "tsx scripts/e2e-reset.ts",
    "setup": "tsx scripts/setup.ts",
    "perf:smoke": "set -a && . ./.env && set +a && k6 run scripts/k6/smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "otplib": "^13.6.0",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.2.1",
    "fast-check": "^4.11.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
