# Postgres connection string.
# Local (default): a Homebrew/native Postgres on :5432.
# Hosted (e.g. Supabase): Dashboard > Project Settings > Database >
#   Connection string > URI. Use the SESSION pooler on :5432 -- Prisma
#   migrations do not work against the transaction pooler on :6543.
# This is about where Postgres lives only. Authentication is local JWT
# (see JWT_SECRET below); no hosted auth provider is used.
DATABASE_URL="postgresql://USER@localhost:5432/medguard_dev?schema=public"

# Database the integration tests run against. Optional: vitest.config.ts
# falls back to postgresql://$USER@localhost:5432/medguard_test when unset.
# The name must contain "test" -- tests/setup/globalSetup.ts refuses to run
# otherwise, because the suite truncates every table.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/medguard_test?schema=public"

# Port this API listens on. The MedGuard frontend owns 8080, so keep these
# apart. src/server.ts defaults to 4000 if this is unset.
PORT=4000

# Origin allowed by CORS. Must match the frontend dev server exactly
# (scheme + host + port, no trailing slash).
FRONTEND_ORIGIN=http://localhost:8080

# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 16 characters; the server refuses to start without it.
JWT_SECRET=

# Password given to every seeded demo account (admin@meridian.org,
# f.alrashid@meridian.org, a.patel@meridian.org). Demo convenience only.
DEMO_USER_PASSWORD=
