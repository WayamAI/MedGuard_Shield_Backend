# Drishti API — environment configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Nothing in this file is a real secret; every value here is a placeholder.

# ---------------------------------------------------------------- database
#
# Environment separation matters more here than anywhere else in the config.
# Four distinct databases, never pointed at each other:
#
#   development  DATABASE_URL       — your working data. Safe to reseed.
#   test         TEST_DATABASE_URL  — truncated on every test run.
#   demo         DATABASE_URL       — the customer-facing dataset.
#   production   DATABASE_URL       — real PHI. Migrations only, never a seed.
#
# Local (default): a Homebrew/native Postgres on :5432.
# Hosted (Neon): copy the connection URI from the project dashboard. It must
#   carry ?sslmode=require. Neon exposes a pooled endpoint (host contains
#   "-pooler") and a direct one; the API runs on the pooled endpoint, while
#   `prisma migrate deploy` needs the direct endpoint.
DATABASE_URL="postgresql://USER@localhost:5432/medguard_dev?schema=public"

# Database the integration tests run against.
#
# The suite TRUNCATES every table, so this must never name your development or
# demo database. Two guards enforce that: vitest.config.ts overrides
# DATABASE_URL with this value for the whole run, and tests/setup/globalSetup.ts
# refuses to start unless the database name contains "test".
#
# Optional: vitest falls back to postgresql://$USER@localhost:5432/medguard_test.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/medguard_test?schema=public"

# ------------------------------------------------------------------ server
#
# Port this API listens on. The frontend owns 8080, so keep these apart.
# src/server.ts defaults to 4000 if unset.
PORT=4000

# Origins allowed by CORS, comma-separated for preview deployments.
# Must match the frontend exactly (scheme + host + port, no trailing slash).
# Never a wildcard: credentials are enabled, and "*" is invalid with them.
FRONTEND_ORIGIN=http://localhost:8080

# development | production
#
# Controls cookie flags. In production the session cookies are Secure and
# SameSite=None, which is what lets the API and app sit on different domains
# and which requires HTTPS on both. Leave unset locally.
# NODE_ENV=production

# ------------------------------------------------------------------- auth
#
# Secret used to sign access JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 16 characters; the server refuses to start without it and
# will not fall back to a default.
#
# Rotating this invalidates every live access token immediately. Refresh
# tokens are unaffected -- they are opaque and stored hashed -- so clients
# recover on their next refresh rather than being logged out.
JWT_SECRET=

# Password for seeded demo accounts. Demo convenience only; there is no seeded
# account in production, and neither seed ever prints this value.
#
# Used by both `npm run db:seed` (destructive, rebuilds everything) and
# `npm run db:seed:demo` (safe, upsert-only). An account that already exists
# keeps whatever password it has -- the safe seed will not overwrite it.
DEMO_USER_PASSWORD=

# ------------------------------------------------------------- demo seed
#
# Which organisation `npm run db:seed:demo` creates or tops up. Everything it
# writes is scoped to this one organisation; nothing outside it is touched.
# Defaults shown; override to point the demo estate at an existing tenant.
# DEMO_ORG_SLUG=drishti-demo
# DEMO_ORG_NAME=Drishti Demo Healthcare

# ----------------------------------------------------------------- docker
#
# Used only by docker-compose.yml. The compose file fails fast rather than
# defaulting these, so a stack cannot come up with a guessable password.
POSTGRES_USER=drishti
POSTGRES_PASSWORD=
POSTGRES_DB=drishti_dev
POSTGRES_PORT=5432
API_PORT=4000
