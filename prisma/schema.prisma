// MedGuard — PHI risk-intelligence data model (demo scope).
//
// Deliberately minimal: no multi-tenancy. Every asset belongs to the single
// demo organisation, so there is no orgId anywhere.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts (migrations) and
// from the driver adapter in src/lib/prisma.ts (runtime), not from here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum AssetType {
  EHR
  DATABASE
  API
  CLOUD_STORAGE
  ANALYTICS
  OTHER
}

enum Sensitivity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Business Associate Agreement state. Under HIPAA a vendor touching PHI
/// without a signed BAA is a compliance breach in itself, independent of
/// whether anything has actually leaked.
enum BaaStatus {
  SIGNED
  PENDING
  EXPIRED
  MISSING
}

/// Humans and machines both hold PHI access. Service accounts are separated
/// because they behave differently: no MFA, no interactive login, and they
/// are the ones that quietly outlive the integration they were created for.
enum IdentityKind {
  USER
  SERVICE_ACCOUNT
}

/// What an identity can do with an asset.
enum AccessLevel {
  READ
  WRITE
  ADMIN
}

enum ThreatSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Lifecycle of a detection. RESOLVED and FALSE_POSITIVE are kept distinct
/// because the difference matters: one is an incident that was handled, the
/// other is a detector that needs tuning.
enum ThreatStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

enum RiskBand {
  LOW
  MODERATE
  HIGH
  CRITICAL
  EXTREME
}

// ---------------------------------------------------------------- models

/// An account that can sign into MedGuard itself. Distinct from Identity,
/// which is a person or service account that holds PHI access elsewhere.
///
/// Both credential columns stay optional because exactly one is ever
/// populated: passwordHash for the local JWT auth that ships today, or
/// externalAuthId if a hosted provider (Supabase/Clerk) is adopted later.
model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  passwordHash   String?
  externalAuthId String?  @unique
  role           Role     @default(VIEWER)
  createdAt      DateTime @default(now())

  @@index([role])
}

/// A system that stores or processes PHI. The four control columns
/// (phiVolume, encrypted, mfaEnabled, lastAssessedAt) are what the risk
/// inputs are argued from during an assessment.
model Asset {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  type           AssetType
  phiVolume      Int       @default(0)
  encrypted      Boolean   @default(false)
  mfaEnabled     Boolean   @default(false)
  lastAssessedAt DateTime?
  createdAt      DateTime  @default(now())

  phiTypes      AssetPHI[]
  outboundFlows DataFlow[] @relation("FlowSource")
  inboundFlows  DataFlow[] @relation("FlowTarget")
  risks         Risk[]
  vendorAccess  VendorAssetAccess[]
  accessGrants  AccessGrant[]
  threats       Threat[]

  @@index([type])
}

/// A category of protected health information, e.g. Clinical or Genetic.
model PHIType {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  sensitivity Sensitivity

  links  AssetPHI[]
  flows  DataFlow[]

  @@index([sensitivity])
}

/// Which PHI categories live in which asset, and at what daily volume.
model AssetPHI {
  assetId       Int
  phiTypeId     Int
  recordsPerDay Int @default(0)

  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  phiType PHIType @relation(fields: [phiTypeId], references: [id], onDelete: Cascade)

  @@id([assetId, phiTypeId])
  @@index([phiTypeId])
}

/// A directed movement of PHI between two assets. Drives the Sankey:
/// recordsPerDay sets ribbon width, encrypted sets ribbon tone.
model DataFlow {
  id            Int     @id @default(autoincrement())
  sourceAssetId Int
  targetAssetId Int
  phiTypeId     Int
  recordsPerDay Int
  encrypted     Boolean @default(true)

  sourceAsset Asset   @relation("FlowSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAsset Asset   @relation("FlowTarget", fields: [targetAssetId], references: [id], onDelete: Cascade)
  phiType     PHIType @relation(fields: [phiTypeId], references: [id], onDelete: Restrict)

  @@index([sourceAssetId])
  @@index([targetAssetId])
  @@index([phiTypeId])
}

/// A scored risk for one asset. The four 1-5 inputs are the assessor's
/// judgement; score and band are derived by src/services/riskEngine.ts and
/// must never be written by hand.
model Risk {
  id          Int      @id @default(autoincrement())
  assetId     Int
  likelihood  Int
  impact      Int
  exposure    Int
  controlGap  Int
  score       Float
  band        RiskBand
  computedAt  DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([band])
  @@index([computedAt])
}

/// A third party with access to PHI. Vendor risk is scored with the same
/// engine as asset risk -- the inputs are argued differently, but the formula
/// and bands are identical, so one change of thresholds moves both.
model Vendor {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  baaStatus      BaaStatus @default(MISSING)
  phiVolume      Int       @default(0)
  lastAssessedAt DateTime?
  createdAt      DateTime  @default(now())

  assetAccess VendorAssetAccess[]
  risks       VendorRisk[]

  @@index([baaStatus])
}

/// Which assets a vendor can reach. Access is the thing that turns a paper
/// compliance gap into an actual exposure, so it is modelled explicitly
/// rather than inferred from data flows.
model VendorAssetAccess {
  vendorId  Int
  assetId   Int
  grantedAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([vendorId, assetId])
  @@index([assetId])
}

/// Scored risk for a vendor. Mirrors Risk, deliberately: same four 1-5
/// inputs, same derived score and band, same rule that score and band are
/// never written by hand.
model VendorRisk {
  id         Int      @id @default(autoincrement())
  vendorId   Int
  likelihood Int
  impact     Int
  exposure   Int
  controlGap Int
  score      Float
  band       RiskBand
  computedAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([band])
}

/// A person or service account that can reach PHI. Distinct from User, which
/// is an account that can log into MedGuard itself -- most identities here
/// never log into this tool at all.
model Identity {
  id          Int          @id @default(autoincrement())
  displayName String
  email       String?      @unique
  kind        IdentityKind @default(USER)
  department  String?
  role        Role         @default(VIEWER)
  active      Boolean      @default(true)
  mfaEnabled  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  grants AccessGrant[]

  @@index([kind])
  @@index([active])
}

/// One identity's access to one asset. lastUsedAt is the field that matters:
/// a grant nobody has exercised in months is the classic over-privilege
/// finding, and it cannot be spotted without recording use separately from
/// the grant date.
model AccessGrant {
  id         Int         @id @default(autoincrement())
  identityId Int
  assetId    Int
  level      AccessLevel @default(READ)
  grantedAt  DateTime    @default(now())
  lastUsedAt DateTime?

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([identityId, assetId])
  @@index([assetId])
  @@index([lastUsedAt])
}

/// A detected threat against an asset. Minimal by design -- enough to drive
/// the threat feed, not a full incident-response record.
model Threat {
  id          Int             @id @default(autoincrement())
  assetId     Int
  severity    ThreatSeverity
  status      ThreatStatus    @default(OPEN)
  title       String
  description String
  detectedAt  DateTime        @default(now())
  resolvedAt  DateTime?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
}
